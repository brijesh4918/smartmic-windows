build/
*.o
*.a

# The prebuilt iOS dependencies are the exception. Without them in the
# repository, cloning and pressing Run in Xcode fails at link time, and
# rebuilding them needs an autotools cross-compile of libsodium that has two
# non-obvious traps (see third_party/ios/README.md). Checking in ~1.9 MB is the
# cheaper trade.
!third_party/ios/lib/*.a
!apps/mobile/ios/smartmic_core/lib/*.a
