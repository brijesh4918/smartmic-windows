;
; smartmic.inf -- SmartMic virtual microphone
;
; Installs one root-enumerated virtual audio device that publishes a single
; capture endpoint named "Smart Microphone".
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = smartmic.cat
DriverVer   = 09/13/2026,1.0.1.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13          ; Driver Store

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
smartmic.sys = 1,,

[Manufacturer]
%ManufacturerName% = SmartMic, NTamd64.10.0...17763, NTarm64.10.0...17763

[SmartMic.NTamd64.10.0...17763]
%SmartMic.DeviceDesc% = SmartMic_Install, root\smartmic

[SmartMic.NTarm64.10.0...17763]
%SmartMic.DeviceDesc% = SmartMic_Install, root\smartmic

;---------------------------------------------------------------------------

[SmartMic_Install.NT]
CopyFiles = SmartMic_CopyFiles

[SmartMic_CopyFiles]
smartmic.sys

[SmartMic_Install.NT.Services]
AddService = smartmic, 0x00000002, SmartMic_Service

[SmartMic_Service]
DisplayName   = %SmartMic.SvcDesc%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\smartmic.sys

[SmartMic_Install.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_Wave%,     SmartMic_Wave_Interface
AddInterface = %KSCATEGORY_CAPTURE%, %KSNAME_Wave%,     SmartMic_Wave_Interface
AddInterface = %KSCATEGORY_REALTIME%,%KSNAME_Wave%,     SmartMic_Wave_Interface
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_Topology%, SmartMic_Topo_Interface
AddInterface = %KSCATEGORY_TOPOLOGY%,%KSNAME_Topology%, SmartMic_Topo_Interface
AddInterface = "{B0C2A1D4-7E31-4B8C-9A57-2E6F1D3C8A90}",, SmartMic_Control_Interface

[SmartMic_Control_Interface]
AddReg = SmartMic_Control_Interface.AddReg

[SmartMic_Control_Interface.AddReg]
HKR,,FriendlyName,,%SmartMic.Control.Name%

[SmartMic_Wave_Interface]
AddReg = SmartMic_Wave_Interface.AddReg

[SmartMic_Wave_Interface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%SmartMic.Wave.Name%

[SmartMic_Topo_Interface]
AddReg = SmartMic_Topo_Interface.AddReg

[SmartMic_Topo_Interface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%SmartMic.Topo.Name%

;---------------------------------------------------------------------------

[Strings]
ManufacturerName     = "SmartMic"
DiskName             = "SmartMic Installation Disk"
SmartMic.DeviceDesc  = "SmartMic Virtual Audio Device"
SmartMic.SvcDesc     = "SmartMic Virtual Audio Driver"
SmartMic.Wave.Name   = "Smart Microphone"
SmartMic.Topo.Name   = "Smart Microphone"
SmartMic.Control.Name = "SmartMic Control Interface"

Proxy.CLSID          = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO     = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE   = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_RENDER    = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME  = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY  = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNAME_Wave          = "Wave"
KSNAME_Topology      = "Topology"
